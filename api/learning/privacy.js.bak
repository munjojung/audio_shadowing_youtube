'use strict';const {getPool}=require('../../lib/db');const A=require('../../lib/learning-auth');
module.exports=async(req,res)=>{if(req.method!=='POST'){res.setHeader('Allow','POST');return res.status(405).json({ok:false,error:'Method not allowed'});}if(!A.guard(req,res))return;const visitor=A.identify(req);if(!visitor)return res.status(401).json({ok:false,error:'Visitor session required'});if(req.body?.action!=='delete')return res.status(400).json({ok:false,error:'Explicit deletion action required'});
 const c=await getPool().connect();try{await c.query('BEGIN');await c.query('DELETE FROM learning_events WHERE session_id IN (SELECT id FROM learning_sessions WHERE visitor_id=$1)',[visitor]);await c.query('DELETE FROM learning_sessions WHERE visitor_id=$1',[visitor]);await c.query('DELETE FROM learning_progress WHERE visitor_id=$1',[visitor]);await c.query('DELETE FROM learning_visitors WHERE id=$1',[visitor]);await c.query('COMMIT');A.clear(res);return res.json({ok:true,deleted:true});}catch(e){await c.query('ROLLBACK');console.error('Learning privacy:',e.message);return res.status(500).json({ok:false,error:'Unable to delete records'});}finally{c.release();}};
