<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shadowing Player Pro</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Google Fonts: Inter & Noto Sans KR -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+KR:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Inter"', '"Noto Sans KR"', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'monospace'],
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom Range Slider Styling */
        input[type="range"] {
            -webkit-appearance: none;
            appearance: none;
            background: transparent;
            cursor: pointer;
        }
        input[type="range"]::-webkit-slider-runnable-track {
            height: 6px;
            border-radius: 9999px;
            background: #e2e8f0;
        }
        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #2563eb;
            margin-top: -5px;
            box-shadow: 0 2px 5px rgba(37, 99, 235, 0.4);
            transition: transform 0.15s ease;
        }
        input[type="range"]::-webkit-slider-thumb:hover {
            transform: scale(1.15);
        }
        /* Recording Pulse Animation */
        @keyframes pulse-rec {
            0% { box-shadow: 0 0 0 0 rgba(225, 29, 72, 0.5); }
            70% { box-shadow: 0 0 0 8px rgba(225, 29, 72, 0); }
            100% { box-shadow: 0 0 0 0 rgba(225, 29, 72, 0); }
        }
        .rec-active {
            animation: pulse-rec 1.5s infinite;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col items-center py-6 px-4 selection:bg-blue-600 selection:text-white">

    <!-- Main Container -->
    <div class="w-full max-w-4xl flex flex-col gap-4">

        <!-- 1. Top Compact File Loader Bar -->
        <header class="bg-white border border-slate-200/90 rounded-2xl px-4 py-2.5 shadow-sm flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-xl bg-blue-600 text-white flex items-center justify-center shadow-sm">
                    <i data-lucide="headphones" class="w-4 h-4"></i>
                </div>
                <span class="font-bold text-sm tracking-tight text-slate-800">Shadowing Player <span class="text-blue-600">Pro</span></span>
                <span id="loadedAudioName" class="text-xs text-slate-400 truncate max-w-[160px] sm:max-w-[240px] ml-1"></span>
            </div>

            <div class="flex flex-wrap items-center gap-2">
                <!-- Audio Upload (.mp3, .wav, .m4a) -->
                <label class="cursor-pointer inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold shadow-sm transition active:scale-95">
                    <i data-lucide="music" class="w-3.5 h-3.5"></i>
                    <span id="audioLabelText">MP3 열기</span>
                    <input type="file" id="audioFileInput" accept=".mp3,.wav,.m4a,audio/*" class="hidden">
                </label>

                <!-- Korean VTT Upload -->
                <label class="cursor-pointer inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 text-xs font-semibold transition active:scale-95">
                    <i data-lucide="captions" class="w-3.5 h-3.5 text-blue-600"></i>
                    <span id="koVttLabelText">KO VTT</span>
                    <input type="file" id="koVttInput" accept=".vtt" class="hidden">
                </label>

                <!-- English VTT Upload -->
                <label class="cursor-pointer inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 text-xs font-semibold transition active:scale-95">
                    <i data-lucide="captions" class="w-3.5 h-3.5 text-indigo-600"></i>
                    <span id="enVttLabelText">EN VTT</span>
                    <input type="file" id="enVttInput" accept=".vtt" class="hidden">
                </label>
            </div>
        </header>

        <!-- 2. Top Subtitle Display Card -->
        <section id="panelScript" class="hidden bg-white border border-slate-200/90 rounded-2xl p-4 shadow-sm flex flex-col gap-3">
            <!-- Header Row -->
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-xs font-bold text-slate-500">
                    <span class="px-1.5 py-0.5 rounded bg-blue-600 text-white text-[10px] font-extrabold tracking-wider">CC</span>
                    <span>실시간 VTT 자막 스크립트</span>
                </div>
                <!-- Segmented Toggle Button [KO | EN] -->
                <div class="inline-flex items-center bg-slate-100 p-0.5 rounded-xl border border-slate-200/60">
                    <button type="button" id="btnLangKo" class="px-3 py-1 rounded-lg text-xs font-bold bg-blue-600 text-white shadow-sm transition">KO</button>
                    <button type="button" id="btnLangEn" class="px-3 py-1 rounded-lg text-xs font-semibold text-slate-600 hover:text-slate-900 transition">EN</button>
                </div>
            </div>

            <!-- Divider Line -->
            <div class="h-px bg-slate-100 w-full"></div>

            <!-- Subtitle Row -->
            <div class="flex items-center gap-3 min-h-[36px] px-1">
                <div class="w-8 h-8 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                    <i data-lucide="volume-2" class="w-4 h-4"></i>
                </div>
                <p id="currentSubtitleText" class="text-base sm:text-lg font-semibold text-slate-800 leading-snug break-words">
                    MP3 및 VTT 파일을 업로드한 후 재생하세요.
                </p>
            </div>
        </section>

        <!-- 3. Main Audio Control Bar Card -->
        <section class="bg-white border border-slate-200/90 rounded-2xl p-4 shadow-sm flex flex-col gap-3">
            <!-- Top Row: Time & Shortcuts -->
            <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
                <div class="font-mono font-semibold text-slate-600">
                    <span id="currentTimeDisplay" class="text-slate-900">00:00</span>
                    <span class="text-slate-400 mx-0.5">/</span>
                    <span id="durationDisplay">00:00</span>
                </div>
                <div class="text-[11px] font-medium text-blue-600">
                    Space: 재생/일시정지 | A/B: 구간설정 | ←/→: 3초 이동
                </div>
            </div>

            <!-- Seek Bar -->
            <div class="relative w-full flex items-center">
                <input type="range" id="seekBar" min="0" max="100" step="0.01" value="0" class="w-full">
            </div>

            <!-- Bottom Control Row -->
            <div class="flex flex-wrap items-center gap-2 pt-1">
                <!-- Skip Backward 3s -->
                <button type="button" id="btnSkipBack" class="w-10 h-10 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center justify-center transition active:scale-95" title="3초 뒤로 (←)">
                    <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                </button>

                <!-- Play / Pause -->
                <button type="button" id="btnPlayPause" class="w-12 h-12 rounded-2xl bg-blue-600 hover:bg-blue-700 text-white shadow-md shadow-blue-500/25 flex items-center justify-center transition active:scale-95" title="재생 / 일시정지 (Space)">
                    <i id="iconPlay" data-lucide="play" class="w-5 h-5 fill-current ml-0.5"></i>
                    <i id="iconPause" data-lucide="pause" class="w-5 h-5 fill-current hidden"></i>
                </button>

                <!-- Skip Forward 3s -->
                <button type="button" id="btnSkipForward" class="w-10 h-10 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center justify-center transition active:scale-95" title="3초 앞으로 (→)">
                    <i data-lucide="rotate-cw" class="w-4 h-4"></i>
                </button>

                <!-- Subtle Vertical Divider -->
                <div class="h-6 w-px bg-slate-200 mx-1 hidden sm:block"></div>

                <!-- Accordion Toggle Button 1: A-B 구간 반복 -->
                <button type="button" id="toggleLoopBtn" class="px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold inline-flex items-center gap-1.5 transition border border-transparent">
                    <i data-lucide="repeat" class="w-3.5 h-3.5 text-blue-600"></i>
                    <span>A-B 구간 반복</span>
                    <span id="loopBadge" class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-slate-200 text-slate-600">OFF</span>
                    <i id="chevronLoop" data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400 transition-transform duration-200"></i>
                </button>

                <!-- Accordion Toggle Button 2: 재생 속도 -->
                <button type="button" id="toggleSpeedBtn" class="px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold inline-flex items-center gap-1.5 transition border border-transparent">
                    <i data-lucide="gauge" class="w-3.5 h-3.5 text-indigo-600"></i>
                    <span>재생 속도</span>
                    <span id="speedBadge" class="font-mono text-[11px] font-bold text-blue-600">1.0x</span>
                    <i id="chevronSpeed" data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400 transition-transform duration-200"></i>
                </button>

                <!-- Accordion Toggle Button 3: 섀도잉 음성 녹음 -->
                <button type="button" id="toggleRecBtn" class="px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold inline-flex items-center gap-1.5 transition border border-transparent">
                    <i data-lucide="mic" class="w-3.5 h-3.5 text-rose-500"></i>
                    <span>섀도잉 음성 녹음</span>
                    <i id="chevronRec" data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400 transition-transform duration-200"></i>
                </button>

                <!-- Accordion Toggle Button 4: 실시간 VTT 자막 -->
                <button type="button" id="toggleScriptBtn" class="px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold inline-flex items-center gap-1.5 transition border border-transparent">
                    <i data-lucide="file-text" class="w-3.5 h-3.5 text-emerald-600"></i>
                    <span>실시간 VTT 자막</span>
                    <i id="chevronScript" data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400 transition-transform duration-200"></i>
                </button>

                <!-- Right Side: Volume Mute/Unmute + Slider -->
                <div class="ml-auto flex items-center gap-2">
                    <button type="button" id="btnMute" class="p-2 rounded-lg text-slate-500 hover:text-slate-800 hover:bg-slate-100 transition" title="음소거 토글">
                        <i id="iconVolumeOn" data-lucide="volume-2" class="w-4 h-4"></i>
                        <i id="iconVolumeOff" data-lucide="volume-x" class="w-4 h-4 text-rose-500 hidden"></i>
                    </button>
                    <input type="range" id="volumeSlider" min="0" max="1" step="0.05" value="1" class="w-20 sm:w-24">
                </div>
            </div>
        </section>

        <!-- 4. Collapsible Secondary Panels (Hidden by Default) -->

        <!-- Panel 1: A-B Loop -->
        <section id="panelLoop" class="hidden bg-white border border-blue-200 rounded-2xl p-4 shadow-sm flex flex-col gap-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-xs font-bold text-blue-600">
                    <i data-lucide="repeat" class="w-4 h-4"></i>
                    <span>A-B 구간 반복 설정</span>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" id="btnToggleLoopActive" class="px-3 py-1 rounded-lg text-xs font-bold bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200 transition">
                        반복 상태: OFF
                    </button>
                    <button type="button" id="btnResetLoop" class="px-3 py-1 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 transition">
                        구간 초기화
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <!-- Point A -->
                <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-3 flex flex-col items-center gap-2">
                    <span class="text-xs font-bold text-emerald-600">Point A (시작)</span>
                    <div id="pointADisplay" class="font-mono text-base font-bold text-slate-800">--:--.--</div>
                    <div class="flex items-center gap-1.5 w-full">
                        <button type="button" id="btnSetA" class="flex-1 py-1.5 px-2.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition active:scale-95">
                            [ A 설정 ]
                        </button>
                        <button type="button" id="btnNudgeAMinus" class="px-2.5 py-1.5 rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-700 font-mono text-xs font-semibold transition">-0.1s</button>
                        <button type="button" id="btnNudgeAPlus" class="px-2.5 py-1.5 rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-700 font-mono text-xs font-semibold transition">+0.1s</button>
                    </div>
                </div>

                <!-- Point B -->
                <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-3 flex flex-col items-center gap-2">
                    <span class="text-xs font-bold text-rose-600">Point B (종료)</span>
                    <div id="pointBDisplay" class="font-mono text-base font-bold text-slate-800">--:--.--</div>
                    <div class="flex items-center gap-1.5 w-full">
                        <button type="button" id="btnSetB" class="flex-1 py-1.5 px-2.5 rounded-lg bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold transition active:scale-95">
                            [ B ] 설정
                        </button>
                        <button type="button" id="btnNudgeBMinus" class="px-2.5 py-1.5 rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-700 font-mono text-xs font-semibold transition">-0.1s</button>
                        <button type="button" id="btnNudgeBPlus" class="px-2.5 py-1.5 rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-700 font-mono text-xs font-semibold transition">+0.1s</button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Panel 2: Playback Speed -->
        <section id="panelSpeed" class="hidden bg-white border border-indigo-200 rounded-2xl p-4 shadow-sm flex flex-col gap-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-xs font-bold text-indigo-600">
                    <i data-lucide="gauge" class="w-4 h-4"></i>
                    <span>재생 속도 조절</span>
                </div>
                <span id="speedPanelDisplay" class="font-mono text-sm font-bold text-blue-600">1.0x</span>
            </div>

            <input type="range" id="speedSlider" min="0.5" max="2.0" step="0.05" value="1.0" class="w-full">

            <div class="grid grid-cols-6 gap-2">
                <button type="button" data-speed="0.5" class="speed-preset-btn py-1.5 rounded-xl bg-slate-100 hover:bg-blue-50 text-slate-700 font-mono text-xs font-semibold transition">0.5x</button>
                <button type="button" data-speed="0.75" class="speed-preset-btn py-1.5 rounded-xl bg-slate-100 hover:bg-blue-50 text-slate-700 font-mono text-xs font-semibold transition">0.75x</button>
                <button type="button" data-speed="1.0" class="speed-preset-btn py-1.5 rounded-xl bg-blue-600 text-white font-mono text-xs font-bold shadow-sm transition">1.0x</button>
                <button type="button" data-speed="1.25" class="speed-preset-btn py-1.5 rounded-xl bg-slate-100 hover:bg-blue-50 text-slate-700 font-mono text-xs font-semibold transition">1.25x</button>
                <button type="button" data-speed="1.5" class="speed-preset-btn py-1.5 rounded-xl bg-slate-100 hover:bg-blue-50 text-slate-700 font-mono text-xs font-semibold transition">1.5x</button>
                <button type="button" data-speed="2.0" class="speed-preset-btn py-1.5 rounded-xl bg-slate-100 hover:bg-blue-50 text-slate-700 font-mono text-xs font-semibold transition">2.0x</button>
            </div>
        </section>

        <!-- Panel 3: Shadowing Recording & Compare -->
        <section id="panelRec" class="hidden bg-white border border-rose-200 rounded-2xl p-4 shadow-sm flex flex-col gap-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-xs font-bold text-rose-600">
                    <i data-lucide="mic" class="w-4 h-4"></i>
                    <span>섀도잉 음성 녹음 & 비교</span>
                </div>
                <span id="recStatusBadge" class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-500">
                    준비됨
                </span>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="flex flex-wrap items-center gap-2">
                    <!-- Record Start / Stop -->
                    <button type="button" id="btnRecordToggle" class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold inline-flex items-center gap-2 shadow-sm transition active:scale-95">
                        <span id="recDot" class="w-2.5 h-2.5 rounded-full bg-white"></span>
                        <span id="recBtnLabel">녹음 시작</span>
                    </button>

                    <!-- Play User Recording -->
                    <button type="button" id="btnPlayMyVoice" disabled class="px-3.5 py-2 rounded-xl bg-slate-100 text-slate-400 disabled:cursor-not-allowed enabled:hover:bg-slate-200 enabled:text-slate-800 text-xs font-semibold inline-flex items-center gap-1.5 transition">
                        <i data-lucide="play" class="w-3.5 h-3.5"></i>
                        <span>내 목소리 듣기</span>
                    </button>
                </div>

                <!-- Sequential Compare -->
                <button type="button" id="btnSequentialCompare" disabled class="px-4 py-2 rounded-xl bg-indigo-50 text-indigo-300 disabled:cursor-not-allowed enabled:bg-indigo-600 enabled:hover:bg-indigo-700 enabled:text-white text-xs font-bold inline-flex items-center gap-1.5 shadow-sm transition">
                    <i data-lucide="arrow-left-right" class="w-3.5 h-3.5"></i>
                    <span>순차 비교 듣기</span>
                </button>
            </div>
        </section>

    </div>

    <!-- Toast Notification Banner -->
    <div id="toastBanner" class="fixed bottom-5 right-5 z-50 translate-y-20 opacity-0 pointer-events-none transition-all duration-300 bg-slate-800 text-white text-xs font-medium px-4 py-2.5 rounded-xl shadow-lg flex items-center gap-2">
        <i data-lucide="info" class="w-4 h-4 text-blue-400"></i>
        <span id="toastText">알림</span>
    </div>

    <!-- Hidden Audio Elements -->
    <audio id="mainAudio" preload="metadata"></audio>
    <audio id="recordedAudio" preload="auto"></audio>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (window.lucide) {
                lucide.createIcons();
            }

            // ==========================================
            // Helper Functions
            // ==========================================
            function parseTimestamp(timeStr) {
                timeStr = timeStr.trim();
                const parts = timeStr.split(':');
                if (parts.length === 3) {
                    const hours = parseFloat(parts[0]);
                    const minutes = parseFloat(parts[1]);
                    const seconds = parseFloat(parts[2].replace(',', '.'));
                    return hours * 3600 + minutes * 60 + seconds;
                } else if (parts.length === 2) {
                    const minutes = parseFloat(parts[0]);
                    const seconds = parseFloat(parts[1].replace(',', '.'));
                    return minutes * 60 + seconds;
                }
                return 0;
            }

            function parseVTT(vttText) {
                if (!vttText) return [];
                const lines = vttText.replace(/\r\n/g, '\n').split('\n');
                const cues = [];
                let i = 0;

                while (i < lines.length) {
                    let line = lines[i].trim();
                    if (line.includes('-->')) {
                        const timeParts = line.split('-->');
                        const start = parseTimestamp(timeParts[0]);
                        const end = parseTimestamp(timeParts[1].split(' ')[0]);

                        let textLines = [];
                        i++;
                        while (i < lines.length && lines[i].trim() !== '') {
                            textLines.push(lines[i].trim());
                            i++;
                        }
                        let text = textLines.join(' ').replace(/<\/?[^>]+(>|$)/g, '');
                        
                        // Remove VTT speaker tags, arrow entities like &gt;&gt;, >>, etc.
                        text = text.replace(/^(&gt;)+|(&gt;)+$/g, '')
                                   .replace(/^>+|%+$/g, '')
                                   .replace(/&gt;&gt;/g, '')
                                   .replace(/>>/g, '')
                                   .trim();

                        if (text) {
                            cues.push({ start, end, text });
                        }
                    } else {
                        i++;
                    }
                }
                return cues;
            }

            function formatTime(seconds, includeMs = false) {
                if (isNaN(seconds) || seconds < 0) return includeMs ? "00:00.00" : "00:00";
                const mins = Math.floor(seconds / 60);
                const secs = Math.floor(seconds % 60);
                const pad = (n) => String(n).padStart(2, '0');
                if (includeMs) {
                    const ms = Math.floor((seconds % 1) * 100);
                    return `${pad(mins)}:${pad(secs)}.${String(ms).padStart(2, '0')}`;
                }
                return `${pad(mins)}:${pad(secs)}`;
            }

            let toastTimer = null;
            function showToast(msg) {
                const banner = document.getElementById('toastBanner');
                const textEl = document.getElementById('toastText');
                if (!banner || !textEl) return;
                textEl.textContent = msg;
                banner.classList.remove('translate-y-20', 'opacity-0');
                banner.classList.add('translate-y-0', 'opacity-100');
                clearTimeout(toastTimer);
                toastTimer = setTimeout(() => {
                    banner.classList.remove('translate-y-0', 'opacity-100');
                    banner.classList.add('translate-y-20', 'opacity-0');
                }, 3000);
            }

            // ==========================================
            // DOM References
            // ==========================================
            const el = {
                mainAudio: document.getElementById('mainAudio'),
                recordedAudio: document.getElementById('recordedAudio'),
                audioFileInput: document.getElementById('audioFileInput'),
                koVttInput: document.getElementById('koVttInput'),
                enVttInput: document.getElementById('enVttInput'),
                loadedAudioName: document.getElementById('loadedAudioName'),
                audioLabelText: document.getElementById('audioLabelText'),
                koVttLabelText: document.getElementById('koVttLabelText'),
                enVttLabelText: document.getElementById('enVttLabelText'),

                btnLangKo: document.getElementById('btnLangKo'),
                btnLangEn: document.getElementById('btnLangEn'),
                currentSubtitleText: document.getElementById('currentSubtitleText'),

                currentTimeDisplay: document.getElementById('currentTimeDisplay'),
                durationDisplay: document.getElementById('durationDisplay'),
                seekBar: document.getElementById('seekBar'),

                btnSkipBack: document.getElementById('btnSkipBack'),
                btnPlayPause: document.getElementById('btnPlayPause'),
                iconPlay: document.getElementById('iconPlay'),
                iconPause: document.getElementById('iconPause'),
                btnSkipForward: document.getElementById('btnSkipForward'),

                toggleLoopBtn: document.getElementById('toggleLoopBtn'),
                toggleSpeedBtn: document.getElementById('toggleSpeedBtn'),
                toggleRecBtn: document.getElementById('toggleRecBtn'),
                toggleScriptBtn: document.getElementById('toggleScriptBtn'),
                chevronLoop: document.getElementById('chevronLoop'),
                chevronSpeed: document.getElementById('chevronSpeed'),
                chevronRec: document.getElementById('chevronRec'),
                chevronScript: document.getElementById('chevronScript'),

                panelLoop: document.getElementById('panelLoop'),
                panelSpeed: document.getElementById('panelSpeed'),
                panelRec: document.getElementById('panelRec'),
                panelScript: document.getElementById('panelScript'),
                transcriptListContainer: document.getElementById('transcriptListContainer'),
                scriptCountBadge: document.getElementById('scriptCountBadge'),
                btnShowDualLang: document.getElementById('btnShowDualLang'),
                chkAutoScroll: document.getElementById('chkAutoScroll'),

                btnMute: document.getElementById('btnMute'),
                iconVolumeOn: document.getElementById('iconVolumeOn'),
                iconVolumeOff: document.getElementById('iconVolumeOff'),
                volumeSlider: document.getElementById('volumeSlider'),

                loopBadge: document.getElementById('loopBadge'),
                btnToggleLoopActive: document.getElementById('btnToggleLoopActive'),
                btnResetLoop: document.getElementById('btnResetLoop'),
                pointADisplay: document.getElementById('pointADisplay'),
                pointBDisplay: document.getElementById('pointBDisplay'),
                btnSetA: document.getElementById('btnSetA'),
                btnNudgeAMinus: document.getElementById('btnNudgeAMinus'),
                btnNudgeAPlus: document.getElementById('btnNudgeAPlus'),
                btnSetB: document.getElementById('btnSetB'),
                btnNudgeBMinus: document.getElementById('btnNudgeBMinus'),
                btnNudgeBPlus: document.getElementById('btnNudgeBPlus'),

                speedBadge: document.getElementById('speedBadge'),
                speedPanelDisplay: document.getElementById('speedPanelDisplay'),
                speedSlider: document.getElementById('speedSlider'),
                speedPresetBtns: document.querySelectorAll('.speed-preset-btn'),

                recStatusBadge: document.getElementById('recStatusBadge'),
                btnRecordToggle: document.getElementById('btnRecordToggle'),
                recDot: document.getElementById('recDot'),
                recBtnLabel: document.getElementById('recBtnLabel'),
                btnPlayMyVoice: document.getElementById('btnPlayMyVoice'),
                btnSequentialCompare: document.getElementById('btnSequentialCompare'),

                toastBanner: document.getElementById('toastBanner'),
                toastText: document.getElementById('toastText')
            };

            const state = {
                subtitles: { ko: [], en: [] },
                currentLang: 'ko',
                showDualLang: false,
                activeCue: null,
                activeCueIndex: -1,
                pointA: null,
                pointB: null,
                isLoopActive: false,
                isRecording: false,
                mediaRecorder: null,
                audioChunks: [],
                recordedBlobUrl: null,
                rafId: null,
                compareTimer: null
            };

            // ==========================================
            // Transcript Rendering
            // ==========================================
            function renderTranscriptList() {
                if (!el.transcriptListContainer) return;
                const primaryList = state.subtitles[state.currentLang] || [];
                const secondaryLang = state.currentLang === 'ko' ? 'en' : 'ko';
                const secondaryList = state.subtitles[secondaryLang] || [];

                if (el.scriptCountBadge) {
                    el.scriptCountBadge.textContent = String(primaryList.length);
                }

                if (primaryList.length === 0) {
                    el.transcriptListContainer.innerHTML = `
                        <div class="p-6 text-center text-xs text-slate-400">
                            ${secondaryList.length > 0
                                ? (state.currentLang === 'ko' ? '한국어(KO) VTT 파일이 업로드되지 않았습니다.' : 'English (EN) VTT file is not uploaded.')
                                : '상단에서 KO VTT 또는 EN VTT 파일을 업로드하면 전체 자막 스크립트가 여기에 표시됩니다.'}
                        </div>
                    `;
                    return;
                }

                const fragment = document.createDocumentFragment();
                primaryList.forEach((cue, idx) => {
                    const row = document.createElement('button');
                    row.type = 'button';
                    row.dataset.index = String(idx);
                    const isActive = idx === state.activeCueIndex;

                    row.className = `transcript-row w-full text-left px-3.5 py-2.5 flex items-start gap-3 transition hover:bg-emerald-50/70 ${
                        isActive ? 'bg-emerald-100/90 border-l-4 border-l-emerald-600' : 'bg-white'
                    }`;

                    let subTextHtml = '';
                    if (state.showDualLang && secondaryList.length > 0) {
                        const matchedSub = secondaryList.find(s => Math.abs(s.start - cue.start) < 1.2) || secondaryList[idx];
                        if (matchedSub) {
                            subTextHtml = `<div class="text-xs text-slate-500 mt-0.5 leading-snug">${matchedSub.text}</div>`;
                        }
                    }

                    row.innerHTML = `
                        <span class="font-mono text-[11px] font-semibold px-1.5 py-0.5 rounded shrink-0 mt-0.5 ${
                            isActive ? 'bg-emerald-600 text-white' : 'bg-slate-100 text-slate-500'
                        }">${formatTime(cue.start)}</span>
                        <div class="flex-1 min-w-0">
                            <div class="text-xs sm:text-sm leading-snug break-words ${
                                isActive ? 'font-bold text-slate-900' : 'font-medium text-slate-700'
                            }">${cue.text}</div>
                            ${subTextHtml}
                        </div>
                    `;

                    row.addEventListener('click', () => {
                        if (!el.mainAudio || !el.mainAudio.src) {
                            showToast('먼저 상단에서 MP3 오디오 파일을 열어주세요.');
                            return;
                        }
                        el.mainAudio.currentTime = cue.start + 0.01;
                        if (el.mainAudio.paused) {
                            el.mainAudio.play().catch(err => console.error(err));
                        }
                        syncPlaybackState();
                    });

                    fragment.appendChild(row);
                });

                el.transcriptListContainer.innerHTML = '';
                el.transcriptListContainer.appendChild(fragment);
            }

            function highlightActiveTranscriptRow(newIndex) {
                if (!el.transcriptListContainer) return;
                const rows = el.transcriptListContainer.querySelectorAll('.transcript-row');
                rows.forEach((row, idx) => {
                    const timeBadge = row.querySelector('span');
                    const mainText = row.querySelector('div > div:first-child');
                    if (idx === newIndex) {
                        row.classList.remove('bg-white');
                        row.classList.add('bg-emerald-100/90', 'border-l-4', 'border-l-emerald-600');
                        if (timeBadge) timeBadge.className = 'font-mono text-[11px] font-semibold px-1.5 py-0.5 rounded shrink-0 mt-0.5 bg-emerald-600 text-white';
                        if (mainText) mainText.className = 'text-xs sm:text-sm leading-snug break-words font-bold text-slate-900';

                        if (el.chkAutoScroll?.checked && !el.panelScript?.classList.contains('hidden')) {
                            el.transcriptListContainer.scrollTo({
                                top: Math.max(0, row.offsetTop - el.transcriptListContainer.offsetTop - 8),
                                behavior: 'smooth'
                            });
                        }
                    } else {
                        row.classList.remove('bg-emerald-100/90', 'border-l-4', 'border-l-emerald-600');
                        row.classList.add('bg-white');
                        if (timeBadge) timeBadge.className = 'font-mono text-[11px] font-semibold px-1.5 py-0.5 rounded shrink-0 mt-0.5 bg-slate-100 text-slate-500';
                        if (mainText) mainText.className = 'text-xs sm:text-sm leading-snug break-words font-medium text-slate-700';
                    }
                });
            }

            function renderSubtitleForTime(currentTime) {
                if (!el.currentSubtitleText) return;
                const list = state.subtitles[state.currentLang] || [];

                if (list.length === 0) {
                    const otherLang = state.currentLang === 'ko' ? 'en' : 'ko';
                    const msg = (state.subtitles[otherLang] || []).length > 0
                        ? (state.currentLang === 'ko' ? '한국어(KO) VTT 파일이 업로드되지 않았습니다.' : 'English (EN) VTT file is not uploaded.')
                        : 'MP3 및 VTT 파일을 업로드한 후 재생하세요.';
                    
                    el.currentSubtitleText.textContent = msg;
                    if (el.panelSubtitleText) el.panelSubtitleText.textContent = msg;
                    if (el.panelSubtitleTime) el.panelSubtitleTime.textContent = "00:00.00";
                    state.activeCue = null;
                    state.activeCueIndex = -1;
                    return;
                }

                let matchedCue = null;
                let matchedIdx = -1;
                for (let i = 0; i < list.length; i++) {
                    if (currentTime >= list[i].start && currentTime <= list[i].end) {
                        matchedCue = list[i];
                        matchedIdx = i;
                        break;
                    }
                }

                if (!matchedCue) {
                    for (let i = list.length - 1; i >= 0; i--) {
                        if (currentTime >= list[i].start) {
                            matchedCue = list[i];
                            matchedIdx = i;
                            break;
                        }
                    }
                }

                if (!matchedCue && list.length > 0) {
                    matchedCue = list[0];
                    matchedIdx = 0;
                }

                state.activeCue = matchedCue;
                if (matchedCue) {
                    if (el.currentSubtitleText.textContent !== matchedCue.text) {
                        el.currentSubtitleText.textContent = matchedCue.text;
                    }
                    if (el.panelSubtitleText && el.panelSubtitleText.textContent !== matchedCue.text) {
                        el.panelSubtitleText.textContent = matchedCue.text;
                    }
                    if (el.panelSubtitleTime) {
                        el.panelSubtitleTime.textContent = `${formatTime(matchedCue.start, true)} ~ ${formatTime(matchedCue.end, true)}`;
                    }
                }

                state.activeCueIndex = matchedIdx;
            }

            function setLanguage(lang) {
                state.currentLang = lang;
                if (el.btnLangKo && el.btnLangEn) {
                    if (lang === 'ko') {
                        el.btnLangKo.className = 'px-3 py-1 rounded-lg text-xs font-bold bg-blue-600 text-white shadow-sm transition';
                        el.btnLangEn.className = 'px-3 py-1 rounded-lg text-xs font-semibold text-slate-600 hover:text-slate-900 transition';
                    } else {
                        el.btnLangEn.className = 'px-3 py-1 rounded-lg text-xs font-bold bg-blue-600 text-white shadow-sm transition';
                        el.btnLangKo.className = 'px-3 py-1 rounded-lg text-xs font-semibold text-slate-600 hover:text-slate-900 transition';
                    }
                }
                const curTime = el.mainAudio ? el.mainAudio.currentTime : 0;
                renderSubtitleForTime(curTime);
            }

            el.btnLangKo?.addEventListener('click', () => setLanguage('ko'));
            el.btnLangEn?.addEventListener('click', () => setLanguage('en'));

            el.btnShowDualLang?.addEventListener('click', () => {
                state.showDualLang = !state.showDualLang;
                if (el.btnShowDualLang) {
                    el.btnShowDualLang.textContent = `한·영 병기: ${state.showDualLang ? 'ON' : 'OFF'}`;
                    el.btnShowDualLang.className = state.showDualLang
                        ? 'px-2.5 py-1 rounded-lg text-[11px] font-bold bg-emerald-100 text-emerald-700 border border-emerald-300 transition'
                        : 'px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 transition';
                }
                renderTranscriptList();
                highlightActiveTranscriptRow(state.activeCueIndex);
            });

            // ==========================================
            // File Uploads & Default GitHub Files Load
            // ==========================================
            el.audioFileInput?.addEventListener('change', (e) => {
                const file = e.target.files?.[0];
                if (!file || !el.mainAudio) return;

                const objectUrl = URL.createObjectURL(file);
                el.mainAudio.src = objectUrl;
                el.mainAudio.load();

                if (el.loadedAudioName) el.loadedAudioName.textContent = file.name;
                if (el.audioLabelText) el.audioLabelText.textContent = 'MP3 변경';
                showToast(`오디오 로드 완료: ${file.name}`);
            });

            el.koVttInput?.addEventListener('change', (e) => {
                const file = e.target.files?.[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = (ev) => {
                    const cues = parseVTT(ev.target.result);
                    state.subtitles.ko = cues;
                    if (el.koVttLabelText) el.koVttLabelText.textContent = `KO (${cues.length})`;
                    setLanguage('ko');
                    renderTranscriptList();
                    showToast(`한국어 VTT 자막 ${cues.length}문장 로드됨`);
                };
                reader.readAsText(file, 'UTF-8');
            });

            el.enVttInput?.addEventListener('change', (e) => {
                const file = e.target.files?.[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = (ev) => {
                    const cues = parseVTT(ev.target.result);
                    state.subtitles.en = cues;
                    if (el.enVttLabelText) el.enVttLabelText.textContent = `EN (${cues.length})`;
                    if (state.subtitles.ko.length === 0) {
                        setLanguage('en');
                    } else {
                        renderSubtitleForTime(el.mainAudio?.currentTime || 0);
                    }
                    renderTranscriptList();
                    showToast(`영어 VTT 자막 ${cues.length}문장 로드됨`);
                };
                reader.readAsText(file, 'UTF-8');
            });

            // Load Default Files from GitHub Repository
            async function loadDefaultFiles() {
                const baseUrl = "https://raw.githubusercontent.com/munjojung/audio_shadowing_youtube/main/7MFVtRS1fRw/";
                const mp3Name = "be_up_be_off_be_away_be_7_7MFVtRS1fRw.mp3";
                const enVttName = "be_up_be_off_be_away_be_7_7MFVtRS1fRw_en.vtt";
                const koVttName = "be_up_be_off_be_away_be_7_7MFVtRS1fRw_ko.vtt";

                // 1. Load MP3
                if (el.mainAudio) {
                    el.mainAudio.src = baseUrl + mp3Name;
                    el.mainAudio.load();
                    if (el.loadedAudioName) el.loadedAudioName.textContent = mp3Name;
                    if (el.audioLabelText) el.audioLabelText.textContent = 'MP3 변경';
                }

                // 2. Load KO VTT
                try {
                    const koRes = await fetch(baseUrl + koVttName);
                    if (koRes.ok) {
                        const koText = await koRes.text();
                        const cues = parseVTT(koText);
                        state.subtitles.ko = cues;
                        if (el.koVttLabelText) el.koVttLabelText.textContent = `KO (${cues.length})`;
                        setLanguage('ko');
                        renderTranscriptList();
                    }
                } catch (err) {
                    console.warn("Default KO VTT load failed:", err);
                }

                // 3. Load EN VTT
                try {
                    const enRes = await fetch(baseUrl + enVttName);
                    if (enRes.ok) {
                        const enText = await enRes.text();
                        const cues = parseVTT(enText);
                        state.subtitles.en = cues;
                        if (el.enVttLabelText) el.enVttLabelText.textContent = `EN (${cues.length})`;
                        renderTranscriptList();
                    }
                } catch (err) {
                    console.warn("Default EN VTT load failed:", err);
                }
            }

            // Trigger default file loading on startup
            loadDefaultFiles();

            // ==========================================
            // Audio Playback & Loop
            // ==========================================
            function syncPlaybackState() {
                if (!el.mainAudio) return;
                const cur = el.mainAudio.currentTime;

                if (el.seekBar && !isNaN(el.mainAudio.duration)) {
                    el.seekBar.value = cur;
                }
                if (el.currentTimeDisplay) {
                    el.currentTimeDisplay.textContent = formatTime(cur);
                }

                if (state.isLoopActive && state.pointA !== null && state.pointB !== null && state.pointB > state.pointA) {
                    if (cur >= state.pointB) {
                        el.mainAudio.currentTime = state.pointA;
                    }
                }

                renderSubtitleForTime(el.mainAudio.currentTime);
                highlightActiveTranscriptRow(state.activeCueIndex);
            }

            function startRafLoop() {
                cancelAnimationFrame(state.rafId);
                const step = () => {
                    if (el.mainAudio && !el.mainAudio.paused && !el.mainAudio.ended) {
                        syncPlaybackState();
                        state.rafId = requestAnimationFrame(step);
                    }
                };
                state.rafId = requestAnimationFrame(step);
            }

            function stopRafLoop() {
                cancelAnimationFrame(state.rafId);
            }

            function togglePlayPause() {
                if (!el.mainAudio || !el.mainAudio.src) {
                    showToast('먼저 상단에서 MP3 오디오 파일을 열어주세요.');
                    return;
                }
                if (el.mainAudio.paused) {
                    el.mainAudio.play().catch(err => console.error(err));
                } else {
                    el.mainAudio.pause();
                }
            }

            el.btnPlayPause?.addEventListener('click', togglePlayPause);

            el.mainAudio?.addEventListener('loadedmetadata', () => {
                if (el.seekBar) el.seekBar.max = el.mainAudio.duration || 100;
                if (el.durationDisplay) el.durationDisplay.textContent = formatTime(el.mainAudio.duration);
                renderSubtitleForTime(0);
            });

            el.mainAudio?.addEventListener('play', () => {
                el.iconPlay?.classList.add('hidden');
                el.iconPause?.classList.remove('hidden');
                startRafLoop();
            });

            el.mainAudio?.addEventListener('pause', () => {
                el.iconPlay?.classList.remove('hidden');
                el.iconPause?.classList.add('hidden');
                stopRafLoop();
                syncPlaybackState();
            });

            el.mainAudio?.addEventListener('ended', () => {
                el.iconPlay?.classList.remove('hidden');
                el.iconPause?.classList.add('hidden');
                stopRafLoop();
                syncPlaybackState();
            });

            el.mainAudio?.addEventListener('timeupdate', syncPlaybackState);

            el.seekBar?.addEventListener('input', (e) => {
                if (!el.mainAudio || !el.mainAudio.src) return;
                el.mainAudio.currentTime = parseFloat(e.target.value) || 0;
                syncPlaybackState();
            });

            el.btnSkipBack?.addEventListener('click', () => {
                if (!el.mainAudio || !el.mainAudio.src) return;
                el.mainAudio.currentTime = Math.max(0, el.mainAudio.currentTime - 3);
                syncPlaybackState();
            });

            el.btnSkipForward?.addEventListener('click', () => {
                if (!el.mainAudio || !el.mainAudio.src) return;
                const dur = el.mainAudio.duration || 0;
                el.mainAudio.currentTime = Math.min(dur, el.mainAudio.currentTime + 3);
                syncPlaybackState();
            });

            // Volume
            function updateVolumeIcons() {
                if (!el.mainAudio) return;
                const isMuted = el.mainAudio.muted || el.mainAudio.volume === 0;
                if (isMuted) {
                    el.iconVolumeOn?.classList.add('hidden');
                    el.iconVolumeOff?.classList.remove('hidden');
                } else {
                    el.iconVolumeOn?.classList.remove('hidden');
                    el.iconVolumeOff?.classList.add('hidden');
                }
            }

            el.volumeSlider?.addEventListener('input', (e) => {
                if (!el.mainAudio) return;
                const vol = parseFloat(e.target.value);
                el.mainAudio.volume = vol;
                el.mainAudio.muted = (vol === 0);
                updateVolumeIcons();
            });

            el.btnMute?.addEventListener('click', () => {
                if (!el.mainAudio) return;
                el.mainAudio.muted = !el.mainAudio.muted;
                updateVolumeIcons();
            });

            // ==========================================
            // Accordion Panels
            // ==========================================
            const accordions = [
                { btn: el.toggleLoopBtn, panel: el.panelLoop, chevron: el.chevronLoop },
                { btn: el.toggleSpeedBtn, panel: el.panelSpeed, chevron: el.chevronSpeed },
                { btn: el.toggleRecBtn, panel: el.panelRec, chevron: el.chevronRec },
                { btn: el.toggleScriptBtn, panel: el.panelScript, chevron: el.chevronScript }
            ];

            accordions.forEach(({ btn, panel, chevron }) => {
                btn?.addEventListener('click', () => {
                    const isCurrentlyHidden = panel?.classList.contains('hidden');

                    accordions.forEach(item => {
                        item.panel?.classList.add('hidden');
                        item.chevron?.classList.remove('rotate-180');
                        item.btn?.classList.remove('ring-2', 'ring-blue-500/40', 'bg-blue-50');
                    });

                    if (isCurrentlyHidden) {
                        panel?.classList.remove('hidden');
                        chevron?.classList.add('rotate-180');
                        btn?.classList.add('ring-2', 'ring-blue-500/40', 'bg-blue-50');
                        if (panel === el.panelScript) {
                            renderTranscriptList();
                            highlightActiveTranscriptRow(state.activeCueIndex);
                        }
                    }
                });
            });

            // ==========================================
            // A-B Loop Controls
            // ==========================================
            function updateLoopUI() {
                if (el.pointADisplay) {
                    el.pointADisplay.textContent = state.pointA !== null ? formatTime(state.pointA, true) : '--:--.--';
                }
                if (el.pointBDisplay) {
                    el.pointBDisplay.textContent = state.pointB !== null ? formatTime(state.pointB, true) : '--:--.--';
                }

                const validLoop = state.isLoopActive && state.pointA !== null && state.pointB !== null && state.pointB > state.pointA;

                if (validLoop) {
                    if (el.loopBadge) {
                        el.loopBadge.textContent = 'ON';
                        el.loopBadge.className = 'px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-700';
                    }
                    if (el.btnToggleLoopActive) {
                        el.btnToggleLoopActive.textContent = '반복 상태: ON';
                        el.btnToggleLoopActive.className = 'px-3 py-1 rounded-lg text-xs font-bold bg-amber-100 text-amber-700 border border-amber-300 transition';
                    }
                } else {
                    if (el.loopBadge) {
                        el.loopBadge.textContent = 'OFF';
                        el.loopBadge.className = 'px-1.5 py-0.5 rounded text-[10px] font-bold bg-slate-200 text-slate-600';
                    }
                    if (el.btnToggleLoopActive) {
                        el.btnToggleLoopActive.textContent = '반복 상태: OFF';
                        el.btnToggleLoopActive.className = 'px-3 py-1 rounded-lg text-xs font-bold bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200 transition';
                    }
                }
            }

            el.btnSetA?.addEventListener('click', () => {
                if (!el.mainAudio || !el.mainAudio.src) {
                    showToast('먼저 오디오 파일을 열어주세요.');
                    return;
                }
                state.pointA = el.mainAudio.currentTime;
                if (state.pointB !== null && state.pointB > state.pointA) {
                    state.isLoopActive = true;
                }
                updateLoopUI();
                showToast(`Point A 설정: ${formatTime(state.pointA, true)}`);
            });

            el.btnSetB?.addEventListener('click', () => {
                if (!el.mainAudio || !el.mainAudio.src) {
                    showToast('먼저 오디오 파일을 열어주세요.');
                    return;
                }
                const cur = el.mainAudio.currentTime;
                if (state.pointA === null) {
                    state.pointA = Math.max(0, cur - 3);
                }
                if (cur <= state.pointA) {
                    showToast('Point B는 Point A보다 뒤의 시간이어야 합니다.');
                    return;
                }
                state.pointB = cur;
                state.isLoopActive = true;
                updateLoopUI();
                showToast(`Point B 설정: ${formatTime(state.pointB, true)}`);
            });

            el.btnResetLoop?.addEventListener('click', () => {
                state.pointA = null;
                state.pointB = null;
                state.isLoopActive = false;
                updateLoopUI();
                showToast('A-B 구간이 초기화되었습니다.');
            });

            el.btnToggleLoopActive?.addEventListener('click', () => {
                if (state.pointA === null || state.pointB === null || state.pointB <= state.pointA) {
                    showToast('먼저 유효한 Point A와 Point B를 설정해주세요.');
                    return;
                }
                state.isLoopActive = !state.isLoopActive;
                updateLoopUI();
            });

            el.btnNudgeAMinus?.addEventListener('click', () => {
                if (state.pointA !== null) {
                    state.pointA = Math.max(0, state.pointA - 0.1);
                    updateLoopUI();
                }
            });
            el.btnNudgeAPlus?.addEventListener('click', () => {
                if (state.pointA !== null) {
                    state.pointA += 0.1;
                    updateLoopUI();
                }
            });
            el.btnNudgeBMinus?.addEventListener('click', () => {
                if (state.pointB !== null) {
                    state.pointB = Math.max((state.pointA || 0) + 0.1, state.pointB - 0.1);
                    updateLoopUI();
                }
            });
            el.btnNudgeBPlus?.addEventListener('click', () => {
                if (state.pointB !== null) {
                    const maxDur = el.mainAudio?.duration || Infinity;
                    state.pointB = Math.min(maxDur, state.pointB + 0.1);
                    updateLoopUI();
                }
            });

            // ==========================================
            // Playback Speed
            // ==========================================
            function setPlaybackSpeed(speedVal) {
                const speed = parseFloat(speedVal) || 1.0;
                if (el.mainAudio) el.mainAudio.playbackRate = speed;
                if (el.speedSlider) el.speedSlider.value = speed;

                const formatted = `${speed.toFixed(2).replace(/\.00$/, '.0')}x`;
                if (el.speedBadge) el.speedBadge.textContent = formatted;
                if (el.speedPanelDisplay) el.speedPanelDisplay.textContent = formatted;

                el.speedPresetBtns?.forEach(btn => {
                    const btnSpeed = parseFloat(btn.dataset.speed);
                    if (Math.abs(btnSpeed - speed) < 0.01) {
                        btn.className = 'speed-preset-btn py-1.5 rounded-xl bg-blue-600 text-white font-mono text-xs font-bold shadow-sm transition';
                    } else {
                        btn.className = 'speed-preset-btn py-1.5 rounded-xl bg-slate-100 hover:bg-blue-50 text-slate-700 font-mono text-xs font-semibold transition';
                    }
                });
            }

            el.speedSlider?.addEventListener('input', (e) => setPlaybackSpeed(e.target.value));
            el.speedPresetBtns?.forEach(btn => {
                btn.addEventListener('click', () => setPlaybackSpeed(btn.dataset.speed));
            });

            // ==========================================
            // Recording & Sequential Compare (Mobile Fix)
            // ==========================================
            el.btnRecordToggle?.addEventListener('click', async () => {
                if (!state.isRecording) {
                    try {
                        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                            showToast('이 브라우저에서는 마이크 녹음을 지원하지 않습니다.');
                            return;
                        }
                        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                        state.audioChunks = [];

                        // Mobile-compatible MIME type detection
                        let options = { mimeType: 'audio/webm;codecs=opus' };
                        if (!MediaRecorder.isTypeSupported(options.mimeType)) {
                            options = { mimeType: 'audio/mp4' };
                            if (!MediaRecorder.isTypeSupported(options.mimeType)) {
                                options = {}; // Browser default
                            }
                        }

                        state.mediaRecorder = new MediaRecorder(stream, options);

                        state.mediaRecorder.ondataavailable = (e) => {
                            if (e.data && e.data.size > 0) {
                                state.audioChunks.push(e.data);
                            }
                        };

                        state.mediaRecorder.onstop = () => {
                            const blobType = state.mediaRecorder.mimeType || 'audio/webm';
                            const blob = new Blob(state.audioChunks, { type: blobType });
                            if (state.recordedBlobUrl) {
                                URL.revokeObjectURL(state.recordedBlobUrl);
                            }
                            state.recordedBlobUrl = URL.createObjectURL(blob);
                            if (el.recordedAudio) {
                                el.recordedAudio.src = state.recordedBlobUrl;
                                el.recordedAudio.load();
                            }

                            if (el.btnPlayMyVoice) el.btnPlayMyVoice.disabled = false;
                            if (el.btnSequentialCompare) el.btnSequentialCompare.disabled = false;

                            if (el.recStatusBadge) {
                                el.recStatusBadge.textContent = '녹음 완료';
                                el.recStatusBadge.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-700';
                            }

                            stream.getTracks().forEach(track => track.stop());
                            showToast('음성 녹음이 완료되었습니다!');
                        };

                        state.mediaRecorder.start(100); // Collect data chunks every 100ms for mobile stability
                        state.isRecording = true;

                        if (el.recBtnLabel) el.recBtnLabel.textContent = '녹음 중지';
                        el.btnRecordToggle?.classList.remove('bg-rose-600', 'hover:bg-rose-700');
                        el.btnRecordToggle?.classList.add('bg-slate-800', 'hover:bg-slate-900', 'rec-active');

                        if (el.recStatusBadge) {
                            el.recStatusBadge.textContent = '녹음 중...';
                            el.recStatusBadge.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-rose-100 text-rose-600';
                        }
                    } catch (err) {
                        console.error('Microphone error:', err);
                        showToast('마이크 접근 권한이 거부되었거나 지원되지 않습니다.');
                    }
                } else {
                    if (state.mediaRecorder && state.mediaRecorder.state !== 'inactive') {
                        state.mediaRecorder.stop();
                    }
                    state.isRecording = false;

                    if (el.recBtnLabel) el.recBtnLabel.textContent = '녹음 시작';
                    el.btnRecordToggle?.classList.remove('bg-slate-800', 'hover:bg-slate-900', 'rec-active');
                    el.btnRecordToggle?.classList.add('bg-rose-600', 'hover:bg-rose-700');
                }
            });

            el.btnPlayMyVoice?.addEventListener('click', () => {
                if (!el.recordedAudio || !el.recordedAudio.src) return;
                clearInterval(state.compareTimer);
                el.mainAudio?.pause();
                el.recordedAudio.currentTime = 0;
                el.recordedAudio.play().catch(err => {
                    console.error('Playback error:', err);
                    showToast('녹음된 오디오 재생 중 오류가 발생했습니다.');
                });
                showToast('녹음된 내 목소리를 재생합니다.');
            });

            el.btnSequentialCompare?.addEventListener('click', () => {
                if (!el.recordedAudio || !el.recordedAudio.src) {
                    showToast('먼저 음성을 녹음해주세요.');
                    return;
                }
                if (!el.mainAudio || !el.mainAudio.src) {
                    showToast('원어민 MP3 오디오 파일이 필요합니다.');
                    return;
                }

                clearInterval(state.compareTimer);
                el.recordedAudio.pause();

                let segStart = 0;
                let segEnd = 0;

                if (state.pointA !== null && state.pointB !== null && state.pointB > state.pointA) {
                    segStart = state.pointA;
                    segEnd = state.pointB;
                } else if (state.activeCue) {
                    segStart = state.activeCue.start;
                    segEnd = state.activeCue.end;
                } else {
                    segStart = Math.max(0, el.mainAudio.currentTime - 3);
                    segEnd = Math.min(el.mainAudio.duration || segStart + 3, segStart + 3);
                }

                const prevLoopState = state.isLoopActive;
                state.isLoopActive = false;

                el.mainAudio.currentTime = segStart;
                el.mainAudio.play().catch(err => console.error(err));
                showToast('① 원어민 구간 재생 중...');

                state.compareTimer = setInterval(() => {
                    if (!el.mainAudio) {
                        clearInterval(state.compareTimer);
                        return;
                    }
                    if (el.mainAudio.currentTime >= segEnd || el.mainAudio.paused || el.mainAudio.ended) {
                        clearInterval(state.compareTimer);
                        el.mainAudio.pause();
                        state.isLoopActive = prevLoopState;

                        setTimeout(() => {
                            showToast('② 내 녹음 음성 재생 중...');
                            el.recordedAudio.currentTime = 0;
                            el.recordedAudio.play().catch(err => console.error(err));
                        }, 350);
                    }
                }, 50);
            });

            // ==========================================
            // Keyboard Shortcuts
            // ==========================================
            document.addEventListener('keydown', (e) => {
                const tag = e.target?.tagName?.toUpperCase();
                if (tag === 'INPUT' || tag === 'TEXTAREA' || e.target?.isContentEditable) {
                    return;
                }

                if (e.code === 'Space') {
                    e.preventDefault();
                    togglePlayPause();
                } else if (e.code === 'ArrowLeft') {
                    e.preventDefault();
                    el.btnSkipBack?.click();
                } else if (e.code === 'ArrowRight') {
                    e.preventDefault();
                    el.btnSkipForward?.click();
                } else if (e.code === 'KeyA') {
                    e.preventDefault();
                    el.btnSetA?.click();
                } else if (e.code === 'KeyB') {
                    e.preventDefault();
                    el.btnSetB?.click();
                }
            });
        });
    </script>
</body>
</html>