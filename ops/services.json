{
  "schemaVersion": 1,
  "productionUrl": "https://shadowing-player-pro.vercel.app",
  "services": [
    {
      "name": "Vercel",
      "variables": [
        "VERCEL_PROJECT_ID",
        "VERCEL_ORG_ID"
      ],
      "note": "CLI project linkage lives in .vercel/project.json; do not copy to git"
    },
    {
      "name": "Neon",
      "variables": [
        "DATABASE_URL"
      ]
    },
    {
      "name": "Cloudflare R2",
      "variables": [
        "R2_ACCOUNT_ID",
        "R2_BUCKET_NAME",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_UPLOAD_ACCESS_KEY_ID",
        "R2_UPLOAD_SECRET_ACCESS_KEY"
      ]
    },
    {
      "name": "Existing admin/review",
      "variables": [
        "ADMIN_API_TOKEN",
        "ADMIN_SESSION_SECRET",
        "LEARNING_SESSION_SECRET",
        "REVIEW_COOKIE_SECRET"
      ]
    },
    {
      "name": "LiveKit Cloud (Production configured)",
      "variables": [
        "LIVEKIT_URL",
        "LIVEKIT_API_KEY",
        "LIVEKIT_API_SECRET"
      ]
    }
  ]
}
